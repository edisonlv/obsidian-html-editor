{
  "name": "obsidian-html-editor",
  "version": "1.1.1",
  "description": "View and edit HTML in Obsidian with CodeMirror, live preview, and optional WYSIWYG in preview",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "html", "editor", "preview"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "5.7.2"
  }
}
